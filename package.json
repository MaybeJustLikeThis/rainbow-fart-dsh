{
  "name": "rainbow-fart-dsh",
  "version": "0.5.6",
  "private": true,
  "type": "module",
  "description": "A playful, optional praise and combo layer for DSH Web coding sessions",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/MaybeJustLikeThis/rainbow-fart-dsh.git" },
  "homepage": "https://github.com/MaybeJustLikeThis/rainbow-fart-dsh#readme",
  "bugs": "https://github.com/MaybeJustLikeThis/rainbow-fart-dsh/issues",
  "keywords": ["dsh", "deepseek-harness", "dsh-plugin", "web", "combo"],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": ["index.js", "client.js", "core.js", "assets/whale-girl.png", "cordis.patch.yml", "OPEN_SOURCE.md", "PRD.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "scripts": {
    "build": "node scripts/build-client.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run build && npm test && node --check client.js"
  }
}
